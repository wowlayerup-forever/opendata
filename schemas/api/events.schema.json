{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wowlayerup-forever/opendata/schemas/v1/api/events.schema.json",
  "title": "api/events",
  "description": "Addon events present in a client build. Files live at data/api/<build>/events.jsonl.",
  "x-primary-key": [
    "name",
    "build_last_seen"
  ],
  "allOf": [
    {
      "$ref": "../defs.schema.json#/$defs/api_provenance"
    }
  ],
  "type": "object",
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "payload": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "inner_type": {
            "type": "string",
            "description": "Element type when type is table (InnerType in Blizzard_APIDocumentation)."
          },
          "mixin": {
            "type": "string",
            "description": "Mixin the value is created from, for example ItemLocationMixin."
          },
          "nilable": {
            "type": "boolean"
          }
        }
      }
    },
    "documented": {
      "type": "boolean",
      "description": "Always true today: events are only known from Blizzard_APIDocumentation, since the client has no way to list events."
    },
    "documentation": {
      "type": "string"
    }
  }
}
